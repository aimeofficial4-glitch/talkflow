# ============================================================================
# TalkFlow Environment Configuration (.env.example)
# Copy to .env for local development
# ============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=4000
CLIENT_PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1
WS_GATEWAY_URL=ws://localhost:4000

# ----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=talkflow_admin
POSTGRES_PASSWORD=talkflow_secret_dev_pass_2026
POSTGRES_DB=talkflow
DATABASE_URL=postgresql://talkflow_admin:talkflow_secret_dev_pass_2026@localhost:5432/talkflow?schema=app&sslmode=disable
DB_POOL_MIN=5
DB_POOL_MAX=25

# ----------------------------------------------------------------------------
# 2. Redis Configuration (Presence, Typing, Pub/Sub, Cache)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=talkflow_redis_secret_pass_2026
REDIS_DB=0
REDIS_PRESENCE_TTL_SEC=60
REDIS_TYPING_TTL_SEC=5
REDIS_URL=redis://:talkflow_redis_secret_pass_2026@localhost:6379/0

# ----------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=talkflow_jwt_access_super_secret_key_change_in_prod_2026!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=talkflow_jwt_refresh_super_secret_key_change_in_prod_2026!
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=talkflow_cookie_signing_secret_998822!
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------------------------------
# 4. Storage & Media (S3 / MinIO CDN compatible)
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local # local | s3 | minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talkflow-media
S3_REGION=eu-west-1
S3_ACCESS_KEY=talkflow_minio_access
S3_SECRET_KEY=talkflow_minio_secret
CDN_BASE_URL=http://localhost:9000/talkflow-media

# ----------------------------------------------------------------------------
# 5. Internationalization & Translation
# ----------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar,es,fr,de,zh,ja,ko,hi,pt,ru,it,tr,fa,ur,he,bn,vi,id,sw,nl,pl,th,el
TRANSLATION_CACHE_TTL_DAYS=30
TRANSLATION_API_KEY=optional_provider_key

# ----------------------------------------------------------------------------
# 6. Push Notifications (FCM / APNs)
# ----------------------------------------------------------------------------
FCM_PROJECT_ID=talkflow-push-dev
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""
